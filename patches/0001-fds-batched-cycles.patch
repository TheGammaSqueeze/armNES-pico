+// Reads that need nothing but the page: program ROM at $8000-$FFFF, and the board's plain pages
+// (on the Disk System its RAM from $6000, where the games run, and its BIOS but for $E445)
+static inline __attribute__((always_inline)) bool pageRead(const struct NES* nes, uint16_t address, const uint8_t* page) {
+	uint16_t bit = 1 << (address >> 12);
+	if (!page || (nes->cheatPages & bit)) {
+		return false;
+	}
+	if (!(nes->readHooks & bit)) {
+		return address >= 0x8000 || (nes->board->plainPages & bit);
+	}
+	return (nes->board->plainPages & bit) && address != nes->board->watchAddress;
+}
+
+// A write to one of the board's plain pages: only the page takes it
+static inline __attribute__((always_inline)) bool pageWrite(struct NES* nes, uint16_t address, uint8_t value) {
+	int page = address >> 12;
+	if (address < 0x4020 || !(nes->board->plainPages & (1 << page))) {
+		return false;
+	}
+	if (nes->prgWritable[page] && nes->prgPages[page]) {
+		nes->prgPages[page][address & 0xFFF] = value;
+	}
+	nes->cpu.openBus = nes->cpu.internalBus = value;
+	return true;
+}
